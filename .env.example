# ── Copy this to .env and fill in your values ─────────────────────────────────

# App
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=/api/v1

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=wati
DB_PASS=CHANGE_THIS_DB_PASSWORD
DB_NAME=wati_angola
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
